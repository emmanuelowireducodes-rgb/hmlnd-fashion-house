# Required for production canonical URLs, social previews, robots and sitemap.
# Set the final public origin without a path or trailing slash.
VITE_SITE_URL=

# Optional authorized Adobe Fonts Web Project stylesheet URL for Futura PT.
VITE_BRAND_FONT_KIT_URL=

# Local HMLND Studio owner bootstrap. Set both for the first local startup only.
# Use a unique password of at least 14 characters; remove them after the owner is created.
STUDIO_BOOTSTRAP_EMAIL=
STUDIO_BOOTSTRAP_PASSWORD=
STUDIO_API_PORT=4310
# Optional absolute path for the local SQLite database and media files.
STUDIO_DATA_DIR=
# Optional local PIN pepper. Set a unique random value of 32+ characters in production.
STUDIO_PIN_PEPPER=
